  ],
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          { "node": "HTTP Request BTCUSDT", "type": "main", "index": 0 },
          { "node": "HTTP Request ETHUSDT", "type": "main", "index": 0 },
          { "node": "HTTP Request SOLUSDT", "type": "main", "index": 0 }
        ]
      ]
    },
    "HTTP Request BTCUSDT": {
      "main": [[{ "node": "Parse BTCUSDT", "type": "main", "index": 0 }]]
    },
    "Parse BTCUSDT": {
      "main": [[{ "node": "Insert BTCUSDT", "type": "main", "index": 0 }]]
    },
    "HTTP Request ETHUSDT": {
      "main": [[{ "node": "Parse ETHUSDT", "type": "main", "index": 0 }]]
    },
    "Parse ETHUSDT": {
      "main": [[{ "node": "Insert ETHUSDT", "type": "main", "index": 0 }]]
    },
    "HTTP Request SOLUSDT": {
      "main": [[{ "node": "Parse SOLUSDT", "type": "main", "index": 0 }]]
    },
    "Parse SOLUSDT": {
      "main": [[{ "node": "Insert SOLUSDT", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": {

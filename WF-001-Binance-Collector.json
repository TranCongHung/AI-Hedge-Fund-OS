{
  "name": "WF-001 Binance Collector",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "id": "sch-trigger-001",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-200, 300]
    },

    {
      "parameters": {
        "method": "GET",
        "url": "https://api.binance.com/api/v3/klines",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "symbol", "value": "BTCUSDT" },
            { "name": "interval", "value": "1m" },
            { "name": "limit", "value": "1" }
          ]
        },
        "options": {}
      },
      "id": "http-btc-001",
      "name": "HTTP Request BTCUSDT",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [100, 100]
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nconst k = raw[0];\nreturn [{\n  json: {\n    symbol: \"BTCUSDT\",\n    open_time: new Date(k[0]).toISOString(),\n    open: parseFloat(k[1]),\n    high: parseFloat(k[2]),\n    low: parseFloat(k[3]),\n    close: parseFloat(k[4]),\n    volume: parseFloat(k[5]),\n    source: \"binance\"\n  }\n}];"
      },
      "id": "code-btc-001",
      "name": "Parse BTCUSDT",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [340, 100]
    },
    {
      "parameters": {
        "operation": "insert",
        "schema": { "value": "public" },
        "table": { "value": "market_data" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "symbol": "={{$json.symbol}}",
            "open_time": "={{$json.open_time}}",
            "open": "={{$json.open}}",
            "high": "={{$json.high}}",
            "low": "={{$json.low}}",
            "close": "={{$json.close}}",
            "volume": "={{$json.volume}}",
            "source": "={{$json.source}}"
          }
        },
        "options": {
          "skipOnConflict": true
        }
      },
      "id": "pg-btc-001",
      "name": "Insert BTCUSDT",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [580, 100],
      "credentials": {
        "postgres": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
          "name": "AIQRP Postgres"
        }
      }
    },

    {
      "parameters": {
        "method": "GET",
        "url": "https://api.binance.com/api/v3/klines",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [

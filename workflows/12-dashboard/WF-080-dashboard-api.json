    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT DISTINCT ON (rad.symbol)\n  rad.symbol, rad.original_signal, rad.original_confidence, rad.risk_level, rad.risk_score,\n  rad.atr_regime, rad.adjusted_signal, rad.adjusted_confidence, rad.position_size_pct, rad.reason, rad.created_at,\n  s.price_at_signal\nFROM risk_adjusted_decisions rad\nLEFT JOIN LATERAL (\n  SELECT price_at_signal FROM signals WHERE signals.symbol = rad.symbol ORDER BY created_at DESC LIMIT 1\n) s ON true\nORDER BY rad.symbol, rad.created_at DESC;",

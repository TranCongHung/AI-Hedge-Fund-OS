    {
      "parameters": {
        "jsCode": "const symbols = $input.all().map(i => i.json.symbol);\nconst intervals = [\n  { interval: '1h', limit: 720, timeframe: '1h' },\n  { interval: '4h', limit: 180, timeframe: '4h' },\n  { interval: '1d', limit: 31,  timeframe: '1d' }\n];\n\nconst combos = [];\nfor (const symbol of symbols) {\n  for (const cfg of intervals) {\n    combos.push({ symbol, interval: cfg.interval, limit: cfg.limit, timeframe: cfg.timeframe });\n  }\n}\n\nreturn combos.map(c => ({ json: c }));"
      },

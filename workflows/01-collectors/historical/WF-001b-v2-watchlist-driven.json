      "position": [
        0,
        0
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 1500,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const combo = $('Loop Over Items').first().json;\nconst items = $input.all().map(i => i.json);\n\nif (!Array.isArray(items) || items.length === 0 || !Array.isArray(items[0])) {\n  return [{ json: { error: true, symbol: combo.symbol, timeframe: combo.timeframe, message: 'khong nhan duoc du lieu hop le' } }];\n}\n\nreturn items.map(k => {\n  if (!Array.isArray(k)) {\n    return { json: { error: true, symbol: combo.symbol, timeframe: combo.timeframe, message: JSON.stringify(k) } };\n  }\n  return { json: {\n    symbol: combo.symbol,\n    timeframe: combo.timeframe,\n    open_time: new Date(k[0]).toISOString(),\n    open: parseFloat(k[1]),\n    high: parseFloat(k[2]),\n    low: parseFloat(k[3]),\n    close: parseFloat(k[4]),\n    volume: parseFloat(k[5]),\n    source: 'binance'\n  } };\n});"
      },
